{
  "rules": {
    "stores": {
      "$branchId": {
        ".read": "auth != null",
        "orders": {
          ".write": "auth != null"
        },
        "daily_summaries": {
          ".write": "auth != null"
        },
        "inventory_snapshot": {
          ".write": "auth != null"
        },
        "heartbeat": {
          ".write": "auth != null"
        },
        "admin_actions_queue": {
          ".read": "auth != null",
          "$actionId": {
            ".write": "auth != null && (auth.token.admin === true || (data.exists() && newData.child('status').val() === 'applied' && newData.child('action_type').val() === data.child('action_type').val()))"
          }
        }
      }
    }
  }
}
