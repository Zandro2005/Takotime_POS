{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "checkJs": false,
    "allowJs": true,
    "moduleResolution": "bundler",
    "strict": false,
    "paths": {
      "@/*": ["./renderer/*"],
      "@shared/*": ["./shared/*"]
    }
  },
  "include": ["main/**/*", "renderer/**/*", "shared/**/*"]
}
