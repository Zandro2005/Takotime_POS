{
  "name": "takotime-pos",
  "version": "1.0.0",
  "description": "TAKOTIME POS — Offline-First Desktop Point of Sale for Takoyaki, Siomai, and Drinks Stall",
  "main": "main/main.js",
  "type": "module",
  "author": "TAKOTIME",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && electron .\"",
    "dev:web": "vite",
    "build:renderer": "vite build",
    "start": "electron .",
    "test": "node --test --test-concurrency=1 tests/unit/*.test.js",
    "package": "node scripts/generate-icons.js && npm run build:renderer && electron-builder build --win",
    "package:mac": "node scripts/generate-icons.js && npm run build:renderer && electron-builder build --mac"
  },
  "build": {
    "appId": "com.takotime.pos",
    "productName": "TAKOTIME POS",
    "npmRebuild": false,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "files": [
      "dist/**/*",
      "main/**/*",
      "shared/**/*",
      "config/**/*",
      "build/icon.png",
      "build/icon.ico",
      "package.json"
    ],
    "asarUnpack": [
      "**/*.node"
    ]
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^18.0.4",
    "electron-updater": "^6.8.9",
    "exceljs": "^4.4.0",
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "xlsx": "^0.18.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "eslint": "^10.11.0",
    "prettier": "^3.9.9",
    "vite": "^8.3.1",
    "wait-on": "^9.1.0"
  }
}
